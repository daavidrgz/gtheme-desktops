{
  "layer": "top",
  "position": "top",
  "margin-left": 10,
  "margin-right": 10,
  "margin-top": 0,
  "margin-bottom": -10,
  "modules-left": ["custom/menu", "clock", "custom/media", "custom/media-prev", "custom/media-play", "custom/media-next"],

  "modules-center": ["hyprland/workspaces"],

  "modules-right": [
    "tray",
    "custom/aibar",
    "custom/notification",
    "network",
    "pulseaudio",
    "battery",
    "custom/power",
  ],

  "hyprland/workspaces": {
    "active-only": false,
    "all-outputs": true,
    "on-click": "activate",
    "format": "{id}",
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5],
    },
  },
  "clock": {
    // "timezone": "America/New_York",
    "tooltip": false,
    "format": "{:%H:%M  -  %A, %d/%m/%y}",
    "interval": 1,
    "on-click": "qs -c ~/.config/quickshell/music msg music toggle",
  },

  "network": {
    "format-wifi": "󰤢  {essid}",
    "format-ethernet": "󰈀  {ifname}",
    "format-disconnected": "󰤠 ",
    "interval": 5,
    "tooltip": false,
    "on-click": "kitty nmtui",
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 {volume}%",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
    },
    "tooltip": false,
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
  },
  "battery": {
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip": false,
  },
  "custom/power": {
    "format": "󰐥",
    "on-click": "wlogout",
    "tooltip": false,
  },
  "custom/aibar": {
    "exec": "~/.config/waybar/scripts/ai-usagebar-themed.sh --icon '󰚩 ' --format '{session_pct}% · {session_reset}' --color-low '#9ece6a' --color-mid '#e0af68' --color-high '#ff9e64' --color-critical '#f7768e'",
    "return-type": "json",
    "interval": 300,
    "signal": 13,
    "tooltip": true,
    "on-click": "kitty --class waybar-aibar-tui -e ai-usagebar-tui",
    "on-scroll-up": "ai-usagebar --cycle-next",
    "on-scroll-down": "ai-usagebar --cycle-prev",
  },
  "tray": {
    "icon-size": 18,
    "spacing": 5,
    "icons": {
      "blueman": "bluetooth",
      "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png",
    },
  },
  "custom/notification": {
    "tooltip": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },
  "custom/media-prev": {
    "format": "󰒮",
    "on-click": "playerctl previous",
    "tooltip": false
  },
  "custom/media": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/media-player.sh title",
    "max-length": 40,
    "tooltip": false,
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  "custom/media-play": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/media-player.sh status",
    "on-click": "playerctl play-pause",
    "tooltip": false
  },
  "custom/media-next": {
    "format": "󰒭",
    "on-click": "playerctl next",
    "tooltip": false
  },
  "custom/menu": {
    "format": "{}",
    "exec": "echo ; echo 󱓟 app launcher",
    "interval": 86400, // once every day
    "tooltip": false,
    "on-click": "pkill rofi || rofi -show drun",
    "on-click-right": "~/.config/hypr/wppicker.sh",
  }
}
