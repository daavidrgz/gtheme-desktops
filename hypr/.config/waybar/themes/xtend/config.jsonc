{
  "layer": "top",
  "position": "bottom",
  "margin-left": 15,
  "margin-right": 15,
  "margin-top": -8,
  "margin-bottom": 3,
  "modules-left": ["hyprland/workspaces"],

  "modules-center": ["custom/media-prev", "custom/media", "custom/media-next"],

  "modules-right": [
    "tray",
    "clock",
    "network",
    "pulseaudio",
    "custom/notification",
    "custom/power",
  ],

  "hyprland/workspaces": {
    "active-only": false,
    "all-outputs": true,
    "on-click": "activate",
    "format": "{id}",
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5],
    },
  },
  "clock": {
    "tooltip": false,
    "format": "   {:%H:%M}",
    "interval": 1,
    "on-click": "qs -c ~/.config/quickshell/music msg music toggle",
  },

  "network": {
    "format-wifi": "󰤢  {essid}",
    "format-ethernet": "󰈀  {ifname}",
    "format-disconnected": "󰤠 ",
    "interval": 5,
    "tooltip": false,
    "on-click": "kitty nmtui",
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": " ",
    "format-icons": {
      "default": ["", "", " "],
    },
    "tooltip": false,
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
  },
  "custom/power": {
    "format": " ",
    "on-click": "wlogout",
    "tooltip": false,
  },
  "tray": {
    "icon-size": 18,
    "spacing": 5,
    "icons": {
      "blueman": "bluetooth",
    },
  },
  "custom/notification": {
    "tooltip": true,
    "format": "<span size='12pt'>{icon}</span>",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },
  "custom/media-prev": {
    "format": "󰒮",
    "on-click": "playerctl previous",
    "tooltip": false
  },
  "custom/media": {
    "format": "{}",
    "exec": "playerctl metadata --format '{{status == \"Playing\" ? \"\" : \"\"}}   {{title}}' --follow 2>/dev/null || echo '  No media'",
    "max-length": 40,
    "tooltip": false,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  "custom/media-next": {
    "format": "󰒭",
    "on-click": "playerctl next",
    "tooltip": false
  },
  "custom/menu": {
    "format": "{}",
    "exec": "echo ; echo 󱓟 app launcher",
    "interval": 86400,
    "tooltip": false,
    "on-click": "pkill rofi || rofi -show drun",
    "on-click-right": "~/.config/hypr/wppicker.sh",
  }
}
