<[output-file]>=~/.config/waybar/colors/colors.css
/*
 * <[theme-name]> - Waybar colors (gtheme generated)
 * Also used by swaync and wlogout via @import
 */

    @define-color background #<[background]>;
    @define-color on_background #<[foreground]>;

    @define-color surface #<[background]>;
    @define-color surface_dim #<[background]>;
    @define-color surface_bright #<[black-hg]>;
    @define-color surface_container #<[black]>;
    @define-color surface_container_low #<[background]>;
    @define-color surface_container_high #<[black-hg]>;
    @define-color surface_container_highest #<[black-hg]>;
    @define-color surface_container_lowest #<[background]>;
    @define-color surface_tint #<[blue]>;
    @define-color surface_variant #<[black-hg]>;
    @define-color on_surface #<[foreground]>;
    @define-color on_surface_variant #<[white]>;

    @define-color primary #<[blue]>;
    @define-color primary_container #<[blue]>;
    @define-color primary_fixed #<[blue-hg]>;
    @define-color primary_fixed_dim #<[blue]>;
    @define-color on_primary #<[background]>;
    @define-color on_primary_container #<[blue-hg]>;
    @define-color on_primary_fixed #<[background]>;
    @define-color on_primary_fixed_variant #<[blue]>;

    @define-color secondary #<[cyan]>;
    @define-color secondary_container #<[black-hg]>;
    @define-color secondary_fixed #<[cyan-hg]>;
    @define-color secondary_fixed_dim #<[cyan]>;
    @define-color on_secondary #<[background]>;
    @define-color on_secondary_container #<[cyan-hg]>;
    @define-color on_secondary_fixed #<[background]>;
    @define-color on_secondary_fixed_variant #<[black-hg]>;

    @define-color tertiary #<[magenta]>;
    @define-color tertiary_container #<[black-hg]>;
    @define-color tertiary_fixed #<[magenta-hg]>;
    @define-color tertiary_fixed_dim #<[magenta]>;
    @define-color on_tertiary #<[background]>;
    @define-color on_tertiary_container #<[magenta-hg]>;
    @define-color on_tertiary_fixed #<[background]>;
    @define-color on_tertiary_fixed_variant #<[black-hg]>;

    @define-color error #<[red]>;
    @define-color error_container #<[red]>;
    @define-color on_error #<[background]>;
    @define-color on_error_container #<[red-hg]>;

    @define-color outline #<[white]>;
    @define-color outline_variant #<[black-hg]>;

    @define-color inverse_surface #<[foreground]>;
    @define-color inverse_on_surface #<[background]>;
    @define-color inverse_primary #<[blue]>;

    @define-color scrim #000000;
    @define-color shadow #000000;
    @define-color source_color #<[blue]>;
