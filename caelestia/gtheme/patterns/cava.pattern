<[output-file]>=~/.config/cava/config
# <[theme-name]> - Cava config (gtheme generated)

[color]
background = 'default'
foreground = '#<[blue]>'

gradient = 1
gradient_color_1 = '#<[blue]>'
gradient_color_2 = '#<[cyan]>'
gradient_color_3 = '#<[blue-hg]>'

horizontal_gradient = 0
horizontal_gradient_color_1 = '#<[blue]>'
horizontal_gradient_color_2 = '#<[cyan]>'
horizontal_gradient_color_3 = '#<[blue-hg]>'
horizontal_gradient_color_4 = '#<[cyan]>'
horizontal_gradient_color_5 = '#<[blue]>'
