<[output-file]>=~/.config/alacritty/alacritty.toml
# <[theme-name]>

[window]

[window.padding]
x = 28
y = 28

[font]
size = <[default-font-size|12]>

[font.normal]
family = "<[default-font|mononoki Nerd Font Mono]>"

[font.bold]
family = "<[default-font|mononoki Nerd Font Mono]>"

[font.italic]
family = "<[default-font|mononoki Nerd Font Mono]>"

[font.offset]
x = 0
y = 1

[cursor.style]
shape = "Beam"

[env]
WINIT_X11_SCALE_FACTOR = "1"

[colors.cursor]
text = "0x<[foreground]>"
cursor = "0x<[cursor]>"

#[colors.selection]
#text = "0x<[selection-foreground]>"
#background = "0x<[selection-background]>"

[colors.primary]
background = "0x<[background]>"
foreground = "0x<[foreground]>"

[colors.normal]
black = "0x<[black]>"
red = "0x<[red]>"
green = "0x<[green]>"
yellow = "0x<[yellow]>"
blue = "0x<[blue]>"
magenta = "0x<[magenta]>"
cyan = "0x<[cyan]>"
white = "0x<[white]>"

[colors.bright]
black = "0x<[black-hg]>"
red = "0x<[red-hg]>"
green = "0x<[green-hg]>"
yellow = "0x<[yellow-hg]>"
blue = "0x<[blue-hg]>"
magenta = "0x<[magenta-hg]>"
cyan = "0x<[cyan-hg]>"
white = "0x<[white-hg]>"
