<[output-file]>=~/.config/alacritty/alacritty.toml
# <[theme-name]>

[window]
dynamic_padding = true

[window.padding]
x = 30
y = 30

[font]
size = <[default-font-size|12]>

[font.normal]
family = "<[default-font|CaskaydiaCove Nerd Font Mono]>"

[font.bold]
family = "<[default-font|CaskaydiaCove Nerd Font Mono]>"

[font.italic]
family = "<[default-font|CaskaydiaCove Nerd Font Mono]>"

[font.offset]
x = 0
y = 1

[cursor.style]
shape = "Beam"

[env]
WINIT_X11_SCALE_FACTOR = "1"

[colors.cursor]
text = "#<[foreground]>"
cursor = "#<[cursor]>"

[colors.primary]
background = "#<[background]>"
foreground = "#<[foreground]>"

[colors.normal]
black = "#<[black]>"
red = "#<[red]>"
green = "#<[green]>"
yellow = "#<[yellow]>"
blue = "#<[blue]>"
magenta = "#<[magenta]>"
cyan = "#<[cyan]>"
white = "#<[white]>"

[colors.bright]
black = "#<[black-hg]>"
red = "#<[red-hg]>"
green = "#<[green-hg]>"
yellow = "#<[yellow-hg]>"
blue = "#<[blue-hg]>"
magenta = "#<[magenta-hg]>"
cyan = "#<[cyan-hg]>"
white = "#<[white-hg]>"
